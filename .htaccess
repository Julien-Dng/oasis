# Oasis Web Agency — URLs propres (sans .html) pour Apache / OVH
Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# /index et /index.html -> / (racine)
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Rediriger les anciennes URLs .html vers la version propre (301)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Servir en interne le fichier .html quand l'URL propre est demandée
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Page d'accueil par défaut
DirectoryIndex index.html
